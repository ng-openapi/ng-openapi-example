{
  "name": "ng-openapi-example",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:json": "ng-openapi -c ./src/app/clients/json-pet-store-client/openapi.config.ts",
    "build:url": "ng-openapi -c ./src/app/clients/url-pet-store-client/openapi.config.ts",
    "build:yaml": "ng-openapi -c ./src/app/clients/yaml-pet-store-client/openapi.config.ts",
    "build:clients": "npm run build:json & npm run build:url & npm run build:yaml"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.13",
    "@angular/compiler": "^21.2.13",
    "@angular/core": "^21.2.13",
    "@angular/forms": "^21.2.13",
    "@angular/platform-browser": "^21.2.13",
    "@angular/router": "^21.2.13",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.11",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.13",
    "@ng-openapi/http-resource": "^0.0.31",
    "@types/jasmine": "~6.0.0",
    "jasmine-core": "~6.2.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "ng-openapi": "0.2.19",
    "typescript": "~5.9.3"
  }
}
