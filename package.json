{
  "name": "ng-openapi-example",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:json": "ng-openapi -c ./src/app/clients/json-pet-store-client/openapi.config.ts",
    "build:url": "ng-openapi -c ./src/app/clients/url-pet-store-client/openapi.config.ts",
    "build:yaml": "ng-openapi -c ./src/app/clients/yaml-pet-store-client/openapi.config.ts",
    "build:clients": "npm run build:json & npm run build:url & npm run build:yaml"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/router": "^22.1.6",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@ng-openapi/http-resource": "^0.2.0",
    "@ng-openapi/zod": "^0.2.0",
    "@types/jasmine": "~6.0.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~7.0.2",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "ng-openapi": "^0.4.0",
    "typescript": "~6.0.3"
  }
}
